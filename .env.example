# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

GEMINI_API_KEY=your_gemini_api_key_here

# Image generation backend: mock | api | local
IMAGE_BACKEND=mock

# Gemini image generation (used only when IMAGE_BACKEND=api)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
IMAGE_REQUEST_TIMEOUT=120

# ComfyUI (used only when IMAGE_BACKEND=local)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=
COMFYUI_MODEL=
COMFYUI_TIMEOUT_SECONDS=600
COMFYUI_POLL_INTERVAL=2

# Legacy backends used by the original analyze --images pipeline
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
